{
  "name": "server",
  "version": "1.0.0",
  "description": "Express.js backend API for Room Management",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:prod": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "node prisma/seeders/seed.js",
    "db:setup": "prisma generate && prisma migrate dev && npm run seed"
  },
  "prisma": {
    "seed": "node prisma/seeders/seed.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.21.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "prisma": "^7.8.0"
  }
}
